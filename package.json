{
  "name": "homesystem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "api": "node --env-file-if-exists=.env --watch server/index.ts",
    "build": "next build",
    "start": "next start",
    "check": "node --test \"lib/*.test.ts\"",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "express": "^5.3.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.1.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.14.0"
