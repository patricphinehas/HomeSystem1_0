# Home System configuration. Copy to .env and edit; .env is not committed.
#
# Read by: next (automatically), and every node entry point via
# --env-file-if-exists=.env (see package.json and scripts/dev.mjs).

# --- Database ---------------------------------------------------------------
# Which database the API, seed, migrate and doctor use. The same app either
# way; only this line changes.
#   sqlite     one file via SQLITE_PATH — nothing to install, nothing to run
#   mongodb    MongoDB via MONGODB_URI / MONGODB_DB
#   supabase   Postgres via DATABASE_URL
DB_SELECT=mongodb

# Used when DB_SELECT=sqlite. The file and its directory are created on first
# use, so `migrate` is optional. Node's built-in node:sqlite drives it, which
# is why this option adds no dependency. Back it up by copying the file; two
# more files appear beside it (-wal, -shm) while the app is running.
SQLITE_PATH=data/homesystem.db

# Used when DB_SELECT=mongodb.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=homesystem

# Used when DB_SELECT=supabase.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# The direct db.* host is IPv6-only and does not resolve here. Use the pooler:
# postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# URL-encode any @ : / ? # % characters in the password.
DATABASE_URL=

# Not used by the app. The server connects with the database password above,
# not through PostgREST, and the schema turns row-level security on with no
# policies so the publishable key cannot read the household's data.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Who this copy belongs to -----------------------------------------------
# Editable on the settings page, which writes this file.
USER_NAME=
HOUSEHOLD_NAME=
# Who lives here is NOT configuration: it is the `family` collection in the
# database, edited on Settings -> Family.

# --- Region -----------------------------------------------------------------
# How dates, numbers and money are written, and what "today" means. Editable on
# Settings -> Region. Changing the currency does not convert anything already
# stored; it changes how it is written.
LOCALE=en-IN
# IANA zone. Leave empty and "today" is today wherever the page is being read.
TIMEZONE=
CURRENCY=INR

# --- Inference engine -------------------------------------------------------
# Behind the chat window on /mcp. All three speak the OpenAI chat-completions
# API, so the only difference is the host, the key and the model name. The model
# must support tool calling or it answers without ever reading the data.
#   ollama       local, no key
#   nvidia       NVIDIA NIM (Nemotron), NVIDIA_API_KEY
#   openrouter   anything hosted, OPENROUTER_API_KEY
CHAT_PROVIDER=ollama

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

NVIDIA_API_KEY=
# NVIDIA retires models and the endpoint then answers 410 Gone. List what
# your key can call: curl -H "authorization: Bearer $NVIDIA_API_KEY" \n#   https://integrate.api.nvidia.com/v1/models
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Processes --------------------------------------------------------------
# The Express data API listens on API_PORT; Next rewrites /api/* to API_URL.
API_PORT=4000
API_URL=http://127.0.0.1:4000

# --- Smart home (edge controllers) ------------------------------------------
# Which controllers exist and what they own is NOT configuration: it is the
# `controllers` and `devices` collections, edited on Smart home -> Setup. Only
# the secrets are here, because a token must never sit in the database or reach
# the browser.
#
# A controller row names the key its token is in, so each box can have its own:
# the default is EDGE_TOKEN, and a controller with no token set is called as an
# open endpoint (fine for a box on your own LAN, not fine over the internet).
EDGE_TOKEN=

# How long to wait on a controller, and how long one /state answer is reused
# before another is fetched. The defaults suit a box on the local network.
EDGE_TIMEOUT_MS=4000
EDGE_CACHE_MS=1500

# scripts/edge-sim.mjs (`pnpm edge`) only. The simulator requires a bearer
# token when EDGE_TOKEN above is set, which is how to test that path.
EDGE_PORT=8099
