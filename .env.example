# Home System configuration. Copy to .env and edit; .env is not committed.
#
# Read by: next (automatically), and every node entry point via
# --env-file-if-exists=.env (see package.json and scripts/dev.mjs).

# --- Supabase ---------------------------------------------------------------
# Required. Supabase dashboard -> Project Settings -> Database ->
# Connection string -> URI. Use the pooled ("Transaction"/port 6543) string for
# a long-running server; the direct 5432 string works too. Replace [YOUR-PASSWORD]
# with the database password, URL-encoding any @ : / ? # % characters in it.
#
# DATABASE_URL=postgresql://postgres.ewsxcppgdstgmbvphbkd:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Not used by the app today. The server connects with the database password
# above, not through PostgREST, and the schema turns row-level security on with
# no policies so the publishable key cannot read the household's data.
# SUPABASE_URL=https://ewsxcppgdstgmbvphbkd.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Processes --------------------------------------------------------------
# The Express data API listens on API_PORT; Next rewrites /api/* to API_URL.
API_PORT=4000
API_URL=http://127.0.0.1:4000
